  <script>
(function () {
  "use strict";

  var LS = { panel: "pg_user_panel", token: "pg_user_token", lang: "pg_user_lang", theme: "pg_user_theme" };

  var DEFAULT_BRAND = {
    name: "PGClock Fusion",
    subtitle: { fa: "پنل اشتراک", en: "Subscription panel" },
    logoUrl: ""
  };

  var BRAND = window.MRCLOCK_BRAND || window.PASARGUARD_BRAND || window.PANEL_BRAND || DEFAULT_BRAND;
  var CONFIG = window.PASARGUARD_CONFIG || window.PANEL_USER_CONFIG || {};

  var state = {
