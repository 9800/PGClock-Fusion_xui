  function fetchLinksFrom(url) {
    return request(url, { credentials: "same-origin", headers: { Accept: "application/json, text/plain, */*" } }, 10000).then(function (res) {
      if (!res.ok) return [];
      var type = res.headers.get("content-type") || "";
      if (type.indexOf("json") > -1) return res.json().then(parseLinks);
      return res.text().then(parseLinks);
    }).then(function (list) {
      return list.map(function (x) { return String(x || "").trim(); }).filter(Boolean);
    }).catch(function () { return []; });
  }

  function fetchLinks() {
    return fetchLinksFrom(state.ctx.linksUrl).then(function (links) {
      if (links.length) return links;
      return fetchLinksFrom(state.ctx.rawUrl);
    }).then(function (links) {
      if (links.length) return links;
      return fetchLinksFrom(state.ctx.subUrl);
    });
  }

  function fetchApps() {
    return request(state.ctx.appsUrl, { credentials: "same-origin", headers: { Accept: "application/json" } }, 10000)
      .then(function (res) { return res.ok ? res.json() : []; })
      .then(function (data) {
        var list = Array.isArray(data) ? data : (data && (data.apps || data.data || data.clients)) || [];
        return Array.isArray(list) ? list.map(normalizeApp) : [];
      }).catch(function () { return []; });
  }

  function usageQuery(range) {
    var end = new Date();
    var days = range === "7d" ? 7 : 1;
    var start = new Date(end.getTime() - days * 86400000);
    return state.ctx.usageUrl + "?period=" + encodeURIComponent(range === "1d" ? "hour" : "day") + "&start=" + encodeURIComponent(start.toISOString()) + "&end=" + encodeURIComponent(end.toISOString());
  }

  function fetchUsage(range) {
    if (!state.ctx) return Promise.resolve(null);
    return request(usageQuery(range), { credentials: "same-origin", headers: { Accept: "application/json" } }, 10000)
      .then(function (res) { return res.ok ? res.json() : null; })
      .catch(function () { return null; });
  }

  function stamp(value) {
    if (value == null || value === "") return null;
    var n = Number(value);
    if (isFinite(n) && String(value).trim() !== "") {
      if (n > 0 && n < 100000000000) n *= 1000;
      return n;
    }
    var t = new Date(value).getTime();
    return isFinite(t) ? t : null;
  }

  function dateText(value) {
    if (!value) return tr("unlimited");
    var ms = stamp(value);
    var d = ms ? new Date(ms) : new Date(value);
    if (isNaN(d.getTime())) return String(value);
    if (!fa()) return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
    try {
      var parts = new Intl.DateTimeFormat("fa-IR-u-nu-arabext", { year: "numeric", month: "long", day: "numeric" }).formatToParts(d);
      var map = {};
      parts.forEach(function (part) { if (part.type !== "literal") map[part.type] = part.value; });
      return "‫" + [map.day, map.month, map.year].filter(Boolean).join(" ") + "‬";
    } catch (e) { return d.toLocaleDateString("fa-IR"); }
  }

  function daysLeftNum(value) {
    var end = stamp(value);
    if (!end) return null;
    return Math.ceil((end - Date.now()) / 86400000);
  }

  function daysLeftText(value) {
    if (!value) return tr("unlimited");
    var days = daysLeftNum(value);
    if (days == null) return dateText(value);
    if (days <= 0) return tr("expired");
    return num(days) + " " + tr("days");
  }

  function bytes(value) {
    value = Number(value);
    if (!isFinite(value)) return "—";
    if (value === 0) return num(0) + " " + tr("bytes");
    var units = [tr("bytes"), tr("kb"), tr("mb"), tr("gb"), tr("tb")];
    var index = Math.min(units.length - 1, Math.floor(Math.log(Math.max(value, 1)) / Math.log(1024)));
    var out = (value / Math.pow(1024, index)).toFixed(index > 1 ? 1 : 0).replace(/\.0$/, "");
    return num(out) + " " + units[index];
  }

  function shortBytes(value) {
    var gb = Number(value || 0) / 1073741824;
    var text = gb < 1 ? gb.toFixed(2) : (gb < 10 ? gb.toFixed(1) : String(Math.round(gb)));
    return num(text.replace(/\.0$/, "")) + "G";
  }

  function get(obj, keys) {
    obj = obj || {};
    for (var i = 0; i < keys.length; i++) {
      if (obj[keys[i]] != null && obj[keys[i]] !== "") return obj[keys[i]];
    }
    return null;
  }

  function statusKey(value) {
    value = String(value || "active").toLowerCase();
    if (value === "enable" || value === "enabled" || value === "true") return "active";
    if (value === "disable" || value === "inactive" || value === "false") return "disabled";
    return value;
  }

  function statusTone(status) {
    status = statusKey(status);
    if (status === "active") return "";
    if (status === "limited" || status === "expired" || status === "on_hold") return "warn";
    return "bad";
  }

  function unlimitedDevices(value) {
    if (value == null || value === "") return true;
    var n = Number(value);
    return !isFinite(n) || n <= 0;
  }

  function formatDeviceCount(value) {
    if (unlimitedDevices(value)) return tr("unlimited");
    var n = Math.floor(Number(value));
    if (fa()) return num(n) + " " + tr("deviceTag");
    return num(n) + " " + (n === 1 ? tr("deviceTag") : tr("devices"));
  }

  function statIcon(name, tone) {
    return '<span class="stat-icon tone-' + esc(tone || "accent") + '" aria-hidden="true">' + svg(name) + '</span>';
  }

  function statCard(kind, label, value, icon, tone) {
    return '<article class="' + kind + '"><div class="stat-top">' + statIcon(icon, tone) + '<span class="k">' + esc(label) + '</span></div><span class="v">' + esc(value) + '</span></article>';
  }

  function setRing(fillEl, cardEl, pct, tone) {
    pct = Math.max(0, Math.min(1, Number(pct) || 0));
    fillEl.style.strokeDasharray = RING_C;
    fillEl.style.strokeDashoffset = RING_C * (1 - pct);
    cardEl.classList.remove("tone-good", "tone-warn", "tone-bad");
    if (tone) cardEl.classList.add("tone-" + tone);
  }

  function renderRings(user, status) {
    var used = Number(get(user, ["used_traffic", "used", "consumed_traffic", "current_traffic"]) || 0);
    var limit = Number(get(user, ["data_limit", "traffic_limit", "total_traffic", "total"]) || 0);
    var expire = status === "on_hold" && user.on_hold_timeout ? user.on_hold_timeout : get(user, ["expire", "expire_date", "expiry_time", "end_time"]);
    var created = get(user, ["created_at", "created", "sub_last_user_agent_at", "start_date"]);

    var days = expire ? daysLeftNum(expire) : null;
    var daysPct = 1, daysTone = "good";
    if (expire && days != null) {
      var total = null;
      var endMs = stamp(expire), startMs = stamp(created);
      if (endMs && startMs && endMs > startMs) total = Math.ceil((endMs - startMs) / 86400000);
      if (!total || total < 1) total = Math.max(days, 30);
      daysPct = Math.max(0, days) / total;
      daysTone = days <= 0 ? "bad" : (days <= 7 ? "warn" : "good");
      $("ring-days-value").textContent = days <= 0 ? tr("expired") : num(Math.max(0, days));
      $("ring-days-unit").textContent = days <= 0 ? "" : tr("days");
      $("ring-days-foot").textContent = tr("untilEnd");
    } else {
      $("ring-days-value").textContent = "∞";
      $("ring-days-unit").textContent = tr("unlimited");
      $("ring-days-foot").textContent = tr("untilEnd");
      daysTone = "";
    }
    setRing($("ring-days"), $("ring-days-card"), daysPct, daysTone);

    var dataPct = 1, dataTone = "good";
    if (limit > 0) {
      var remain = Math.max(0, limit - used);
      dataPct = remain / limit;
      dataTone = dataPct <= 0.02 ? "bad" : (dataPct <= 0.15 ? "warn" : "good");
      $("ring-data-value").textContent = num(Math.round(dataPct * 100)) + "%";
      $("ring-data-unit").textContent = tr("remainWord");
      $("ring-data-foot").innerHTML = esc(tr("leftWord")) + " <b>" + esc(bytes(remain)) + "</b> " + esc(tr("ofWord")) + " <b>" + esc(bytes(limit)) + "</b>";
    } else {
      $("ring-data-value").textContent = "∞";
      $("ring-data-unit").textContent = tr("unlimited");
      $("ring-data-foot").innerHTML = esc(tr("used")) + ": <b>" + esc(bytes(used)) + "</b>";
      dataTone = "";
    }
    setRing($("ring-data"), $("ring-data-card"), dataPct, dataTone);
  }

  function expireHero(user, status) {
    var expire = status === "on_hold" && user.on_hold_timeout ? user.on_hold_timeout : get(user, ["expire", "expire_date", "expiry_time", "end_time"]);
    var el = $("expire-date");
    el.classList.remove("tone-warn", "tone-bad");
    if (!expire) {
      el.textContent = tr("unlimited");
      $("expire-hint").textContent = "";
      return;
    }
    el.textContent = dateText(expire);
    var days = daysLeftNum(expire);
    if (days != null) {
      if (days <= 0) { el.classList.add("tone-bad"); $("expire-hint").textContent = tr("expired"); }
      else {
        if (days <= 7) el.classList.add("tone-warn");
        $("expire-hint").textContent = num(days) + " " + tr("days") + (fa() ? " دیگر" : " " + tr("leftWord"));
      }
    } else $("expire-hint").textContent = "";
  }

  function isOnline(user) {
    var online = get(user, ["online_at", "last_online", "last_connected_at"]);
    var ms = stamp(online);
    return !!(ms && Date.now() - ms < 3 * 60000);
  }

  function renderAccount() {
    var user = state.user || {};
    var has = !!state.user;
    var username = get(user, ["username", "name", "email"]) || "—";
    var status = statusKey(get(user, ["status", "state", "enabled"]) || "active");
    var tone = statusTone(status);
    var used = Number(get(user, ["used_traffic", "used", "consumed_traffic", "current_traffic"]) || 0);
    var limit = Number(get(user, ["data_limit", "traffic_limit", "total_traffic", "total"]) || 0);
    var remain = limit > 0 ? Math.max(0, limit - used) : Infinity;
    var expire = get(user, ["expire", "expire_date", "expiry_time", "end_time"]);
    var online = get(user, ["online_at", "last_online", "last_connected_at"]);
    var deviceLimit = get(user, ["hwid_limit", "device_limit", "ip_limit", "max_ips", "max_devices"]);

    $("avatar-letter").textContent = username !== "—" ? String(username).charAt(0).toUpperCase() : "؟";
    $("presence").classList.toggle("on", isOnline(user));
    $("status-dot").className = "dot";
    $("status-chip").className = "chip " + (tone === "bad" ? "status-bad" : (tone === "warn" ? "status-warn" : "status-active"));
    $("status-label").textContent = has ? (tr(status) || status) : tr("unknown");
    $("username").textContent = username;
    $("subline").textContent = has ? "" : tr("emptyState");
    $("profile-shortcuts").classList.toggle("hidden", !(state.ctx && state.ctx.subUrl));
    document.title = has && username !== "—" ? username : (fa() ? "پنل کاربری" : "User Panel");

    expireHero(user, status);
    renderRings(user, status);

    $("profile-chips").innerHTML = [
      '<span class="chip">' + esc(num(state.links.length) + " " + tr("configTag")) + '</span>',
      '<span class="chip">' + esc(num(state.apps.length) + " " + tr("appTag")) + '</span>',
      '<span class="chip">' + esc(formatDeviceCount(deviceLimit)) + '</span>'
    ].join("");

    $("metrics").innerHTML = [
      statCard("metric", tr("expire"), status === "on_hold" && user.on_hold_timeout ? daysLeftText(user.on_hold_timeout) : daysLeftText(expire), "statCalendar", "violet"),
      statCard("metric", tr("used"), bytes(used), "statTrend", "cyan"),
      statCard("metric", tr("remain"), limit > 0 ? bytes(remain) : "∞", "statRemain", "good"),
      statCard("metric", tr("limit"), limit > 0 ? bytes(limit) : "∞", "statDatabase", "accent"),
      statCard("metric", tr("online"), online ? dateText(online) : tr("never"), "statActivity", online ? "rose" : "muted"),
      statCard("metric", tr("lifetime"), bytes(get(user, ["lifetime_used_traffic", "lifetime_traffic"]) || used), "statLifetime", "orange")
    ].join("");

    $("details").innerHTML = has ? [
      statCard("detail", tr("created"), get(user, ["created_at", "created"]) ? dateText(get(user, ["created_at", "created"])) : "—", "statCreated", "teal"),
      statCard("detail", tr("updated"), get(user, ["edit_at", "updated_at", "modified_at"]) ? dateText(get(user, ["edit_at", "updated_at", "modified_at"])) : "—", "statRefresh", "rose"),
      statCard("detail", tr("ip"), get(user, ["ip", "last_ip"]) || "—", "statGlobe", get(user, ["ip", "last_ip"]) ? "warn" : "muted"),
      statCard("detail", tr("deviceCapacity"), formatDeviceCount(deviceLimit), "statDevice", "violet")
    ].join("") : "";
  }

  function decodeAnnounce(raw) {
    if (!raw) return "";
    if (raw.indexOf("base64:") === 0) return b64(raw.slice(7)) || raw.slice(7);
    try { return decodeURIComponent(raw); } catch (e) { return raw; }
  }

  function getAlerts() {
    var user = state.user || {};
    var alerts = [];
    var used = Number(get(user, ["used_traffic", "used", "consumed_traffic", "current_traffic"]) || 0);
    var limit = Number(get(user, ["data_limit", "traffic_limit", "total_traffic", "total"]) || 0);
    var expire = get(user, ["expire", "expire_date", "expiry_time", "end_time"]);
    if (limit > 0) {
      var remain = Math.max(0, limit - used);
      if (remain <= Math.min(1073741824, limit * 0.12)) alerts.push(tr("lowTraffic"));
    }
    var end = stamp(expire);
    if (end) {
      var days = Math.ceil((end - Date.now()) / 86400000);
      if (days > 0 && days <= 3) alerts.push(tr("lowTime"));
    }
    return alerts;
  }

  function renderAlerts() {
    var alerts = getAlerts();
    $("alert").classList.toggle("show", alerts.length > 0);
    $("alert-text").textContent = alerts.join(" · ");
    $("support-btn").classList.toggle("alert-active", alerts.length > 0);
  }

  function renderNotice() {
    var text = decodeAnnounce(state.headers.announce || "");
    var url = state.headers.announceUrl || "";
    $("notice").classList.toggle("show", !!(text || url));
    $("notice-text").innerHTML = esc(text || "") + (url ? ' <a href="' + esc(url) + '" target="_blank" rel="noopener">' + esc(tr("linkLabel")) + '</a>' : "");
    renderAlerts();
  }

  function normalizeContactUrl(value) {
    if (value && typeof value === "object") value = value[state.lang] || value.fa || value.en || "";
    value = String(value || "").trim();
    if (!value) return "";
    if (value.charAt(0) === "@") return "https://t.me/" + encodeURIComponent(value.slice(1));
    if (/^[\w.]{3,}$/.test(value) && value.indexOf("@") < 0 && value.indexOf(".") < 0) return "https://t.me/" + encodeURIComponent(value);
    if (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) return "mailto:" + value;
    if (/^https?:\/\//i.test(value) || /^mailto:|^tel:/i.test(value)) return value;
    if (/^(t\.me|telegram\.me|wa\.me)\//i.test(value)) return "https://" + value;
    if (/^[\w.-]+\.[a-z]{2,}(?:\/.*)?$/i.test(value)) return "https://" + value;
    return "";
  }

  function supportUrl() {
    var user = state.user || {};
    return normalizeContactUrl(
      get(user, ["support_url", "support_link", "support", "support_href", "telegram_url", "telegram_link", "telegram", "telegram_id", "contact_url", "contact_link", "contact", "help_url"]) ||
      state.headers.supportUrl || CONFIG.supportUrl || CONFIG.support_url || ""
    );
  }

  function renderSupport() {
    var url = supportUrl();
    var btn = $("support-btn");
    btn.classList.toggle("hidden", !url);
    btn.href = url || "#";
    btn.title = tr("support");
    btn.setAttribute("aria-label", tr("support"));
  }

  var COUNTRY_WORDS = {
    iran: "IR", germany: "DE", german: "DE", germani: "DE", deutschland: "DE",
    sweden: "SE", finland: "FI", france: "FR", netherlands: "NL", holland: "NL",
    turkey: "TR", turkiye: "TR", uae: "AE", emirates: "AE", dubai: "AE",
    usa: "US", america: "US", "united states": "US", uk: "GB", england: "GB", britain: "GB",
    canada: "CA", japan: "JP", singapore: "SG", russia: "RU", poland: "PL",
    italy: "IT", spain: "ES", austria: "AT", switzerland: "CH", norway: "NO",
    denmark: "DK", belgium: "BE", bulgaria: "BG", romania: "RO", czech: "CZ",
    ukraine: "UA", armenia: "AM", georgia: "GE", qatar: "QA", india: "IN",
    china: "CN", hongkong: "HK", "hong kong": "HK", korea: "KR", australia: "AU", brazil: "BR"
  };
  var ISO_CODES = "IR DE SE FI FR NL TR AE US GB CA JP SG RU PL IT ES AT CH NO DK BE BG RO CZ UA AM GE QA IN CN HK KR AU BR KZ AZ IQ OM SA KW LU IE PT GR HU RS AL MD EE LV LT".split(" ");

  function flagCode(code) {
    code = String(code || "").toUpperCase();
    return /^[A-Z]{2}$/.test(code) ? code : "";
  }

  function flagSvg(code) {
    code = flagCode(code);
    if (!code) return "";
    return '<img class="flag-svg" src="https://cdn.jsdelivr.net/gh/HatScripts/circle-flags@2.7.0/flags/' + code.toLowerCase() + '.svg" alt="' + code + '" loading="lazy">';
  }

  function countryFlag(name) {
    name = String(name || "");
    var em = name.match(/[\uD83C][\uDDE6-\uDDFF][\uD83C][\uDDE6-\uDDFF]/);
    if (em) {
      var iso = String.fromCharCode(em[0].codePointAt(0) - 0x1F1E6 + 65, em[0].codePointAt(2) - 0x1F1E6 + 65);
      return flagSvg(iso);
    }
    var lower = name.toLowerCase();
    for (var word in COUNTRY_WORDS) {
      if (lower.indexOf(word) > -1) return flagSvg(COUNTRY_WORDS[word]);
    }
    var tokens = name.toUpperCase().match(/\b[A-Z]{2}\b/g) || [];
    for (var i = 0; i < tokens.length; i++) {
      if (ISO_CODES.indexOf(tokens[i]) > -1) return flagSvg(tokens[i]);
    }
    return "";
  }

  function linkType(raw) {
    raw = String(raw || "").toLowerCase();
    if (raw.indexOf("vless://") === 0) return "VLESS";
    if (raw.indexOf("vmess://") === 0) return "VMess";
    if (raw.indexOf("trojan://") === 0) return "Trojan";
    if (raw.indexOf("wireguard://") === 0 || raw.indexOf("[interface]") === 0) return "WireGuard";
    if (raw.indexOf("hysteria2://") === 0 || raw.indexOf("hy2://") === 0) return "Hysteria2";
    if (raw.indexOf("hysteria") === 0) return "Hysteria";
    if (raw.indexOf("ss://") === 0 || raw.indexOf("shadowsocks") === 0) return "Shadowsocks";
    if (/^https?:\/\//.test(raw)) return "Link";
    return "Proxy";
  }

  function linkTags(raw) {
    raw = String(raw || "");
    var tags = [{ text: linkType(raw), cls: "proto" }];
    try {
      if (/^vmess:\/\//i.test(raw)) {
        var data = JSON.parse(b64(raw.slice(8)));
        if (data) {
          if (data.tls && data.tls !== "none") tags.push({ text: String(data.tls).toUpperCase(), cls: "sec" });
          if (data.net) tags.push({ text: String(data.net).toUpperCase(), cls: "net" });
        }
        return tags;
      }
      var u = new URL(raw);
      var p = u.searchParams;
      var sec = (p.get("security") || "").toLowerCase();
      if (sec && sec !== "none") tags.push({ text: sec.toUpperCase(), cls: "sec" });
      var net = (p.get("type") || p.get("network") || "").toLowerCase();
      if (net && net !== "none") tags.push({ text: net.toUpperCase(), cls: "net" });
    } catch (e) {}
    return tags.slice(0, 3);
  }

  function configName(raw) {
    raw = String(raw || "");
    try {
      if (raw.toLowerCase().indexOf("vmess://") === 0) {
        var data = JSON.parse(b64(raw.slice(8)));
        if (data && data.ps) return decodeSafe(data.ps);
      }
      var u = new URL(raw);
      var hash = decodeSafe(u.hash.replace(/^#/, ""));
      if (hash) return hash;
      return decodeSafe(u.searchParams.get("name") || u.searchParams.get("remark") || u.searchParams.get("tag") || "");
    } catch (e) {}
    var index = raw.indexOf("#");
    return index >= 0 ? decodeSafe(raw.slice(index + 1)) : "";
  }

  function renderConfigs() {
    var items = [];
    if (state.ctx) items.push({ title: tr("subLink"), payload: state.ctx.subUrl, icon: "link", tags: [], flag: "" });
    state.links.forEach(function (raw, index) {
      var title = configName(raw) || linkType(raw) + " " + num(index + 1);
      items.push({ title: title, payload: raw, icon: "net", tags: linkTags(raw), flag: countryFlag(title) });
    });
    state.configItems = items;
    $("configs-note").textContent = state.links.length ? num(state.links.length) + " " + tr("configTag") : tr("configsNote");
    if (!items.length) {
      $("config-list").innerHTML = '<div class="empty">' + esc(tr("noConfig")) + '</div>';
      return;
    }
    $("config-list").innerHTML = items.map(function (item, index) {
      var canDownload = !!wireguardConfigText(item.payload);
      var lead = item.flag ? '<span class="flag">' + item.flag + '</span>' : '<span class="flag">' + svg(item.icon) + '</span>';
      var tagsHtml = item.tags.length ? '<span class="tag-row">' + item.tags.map(function (t) {
        return '<span class="tag ' + esc(t.cls) + '">' + esc(t.text) + '</span>';
      }).join("") + '</span>' : "";
      return '<article class="config-card" data-index="' + index + '" data-title="' + esc(item.title) + '">' +
        lead +
        '<span class="item-main"><span class="item-title">' + esc(item.title) + '</span>' + tagsHtml + '</span>' +
        '<span class="row-actions">' +
        '<button class="icon-btn" type="button" data-action="qr" aria-label="' + esc(tr("qr")) + '">' + svg("qr") + '</button>' +
        '<button class="icon-btn" type="button" data-action="copy" aria-label="' + esc(tr("copy")) + '">' + svg("copy") + '</button>' +
        (canDownload ? '<button class="icon-btn" type="button" data-action="download" aria-label="' + esc(tr("download")) + '">' + svg("download") + '</button>' : "") +
        '</span></article>';
    }).join("");
  }

  function localizedText(value) {
    if (!value) return "";
    if (typeof value === "string") return value;
    if (typeof value !== "object") return String(value);
    var lang = state.lang === "fa" ? "fa" : "en";
    if (value[lang]) return String(value[lang]);
    if (lang === "en" && value.fa) return String(value.fa);
    return "";
  }

  function normalizeAppLang(value) {
    value = String(value || "").toLowerCase().trim();
    if (!value) return "";
    if (value.indexOf("fa") === 0 || value === "persian" || value === "فارسی") return "fa";
    if (value.indexOf("en") === 0 || value === "english") return "en";
    return value;
  }

  function filterAppDownloadLinks(links) {
    links = (links || []).filter(function (item) { return item && item.url; });
    var lang = state.lang === "fa" ? "fa" : "en";
    var matched = links.filter(function (item) {
      var itemLang = normalizeAppLang(item.language || item.lang || item.locale);
      if (!itemLang) return lang === "fa";
      return itemLang === lang;
    });
    if (matched.length) return matched;
    if (lang === "en") {
      return links.filter(function (item) {
        return normalizeAppLang(item.language || item.lang || item.locale) === "fa";
      });
    }
    return [];
  }

  function normalizeApp(app) {
    if (typeof app === "string") return { name: app, platform: detectPlatform(app), download_links: [], import_url: "", icon: "" };
    app = app || {};
    var name = app.name || app.title || app.app || app.client || app.label || app.platform || "App";
    var platform = canonical(app.platform || app.os || app.client_type || detectPlatform([name, app.url, app.link, app.download].join(" ")));
    var links = app.download_links || app.downloads || app.links || [];
    if (!Array.isArray(links)) links = [];
    var direct = app.url || app.link || app.download || app.href;
    if (direct) {
      links = [{ name: app.download_name || tr("download"), url: direct, language: app.download_language || app.language || app.lang || "" }].concat(links);
    }
    return {
      name: name, platform: platform,
      description: app.description || app.desc || app.subtitle || "",
      download_links: links,
      import_url: app.import_url || app.import || app.add_url || "",
      recommended: !!app.recommended,
      icon: app.icon_url || app.icon || app.logo_url || app.logo || app.image_url || app.image || ""
    };
  }

  function renderApps() {
    if (!state.apps.length) {
      $("os-grid").innerHTML = '<div class="empty">' + esc(tr("noApps")) + '</div>';
      return;
    }
    var groups = {};
    state.apps.forEach(function (app) {
      var key = canonical(app.platform);
      if (!groups[key]) groups[key] = [];
      groups[key].push(app);
    });
    state.groups = groups;
    var current = currentOS();
    var order = ["ios", "android", "windows", "macos", "linux", "appletv", "androidtv", "web", "other"];
    if (groups[current]) order = [current].concat(order.filter(function (x) { return x !== current; }));
    var keys = order.filter(function (key) { return groups[key] && groups[key].length; });
    Object.keys(groups).sort().forEach(function (key) { if (keys.indexOf(key) < 0) keys.push(key); });
    $("os-grid").innerHTML = keys.map(function (key) {
      return '<article class="os-card ' + (key === current ? "current" : "") + '" data-platform="' + esc(key) + '">' +
        '<span class="os-icon">' + platformIcon(key) + '</span>' +
        '<span class="os-info"><span class="os-name">' + esc(platformLabel(key)) + '</span>' +
        (key === current ? '<span class="badge current-tag">' + esc(tr("yourOS")) + '</span>' : '') +
        '</span><button class="small-btn os-open" type="button">' + esc(tr("openApps")) + '</button></article>';
    }).join("");
  }

  function actionLinkClass(label) {
    var text = String(label || "").toLowerCase();
    if (/افزودن|import|add\s+sub|subscribe|subscription|اضافه/.test(text)) return "action-import";
    return "action-download";
  }

  function openApps(platform) {
    var list = state.groups[platform] || [];
    state.appsModalPlatform = platform;
    $("apps-modal-title").textContent = platformLabel(platform);
    $("apps-modal-sub").textContent = num(list.length) + " " + tr("app");
    $("app-list").innerHTML = list.map(appHtml).join("");
    openModal("apps-modal");
  }

  function appHtml(app) {
    var desc = localizedText(app.description);
    var iconHtml = app.icon
      ? '<img src="' + esc(resolveUrl(app.icon)) + '" alt="" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'grid\'"><span style="display:none;width:100%;height:100%;place-items:center;">' + platformIcon(app.platform) + '</span>'
      : platformIcon(app.platform);
    var links = filterAppDownloadLinks(app.download_links || []);
    var linkHtml = links.map(function (item) {
      var label = localizedText(item.name) || (typeof item.name === "string" ? item.name : "") || tr("download");
      return '<a class="' + esc(actionLinkClass(label)) + '" href="' + esc(resolveUrl(item.url)) + '" target="_blank" rel="noopener">' + esc(label) + '</a>';
    }).join("");
    var importHtml = app.import_url ? '<a class="action-import" href="' + esc(resolveUrl(app.import_url)) + '" target="_blank" rel="noopener">' + esc(tr("import")) + '</a>' : "";
    var actions = linkHtml + importHtml;
    return '<article class="app-card"><div class="app-head"><span class="app-icon">' + iconHtml + '</span>' +
      '<span class="app-info"><span class="app-name"><span>' + esc(localizedText(app.name) || (typeof app.name === "string" ? app.name : "App")) + '</span>' +
      (app.recommended ? '<span class="badge rec">' + esc(tr("recommended")) + '</span>' : '') + '</span>' +
      (desc ? '<p class="app-desc">' + esc(desc) + '</p>' : '') + '</span></div>' +
      (actions ? '<div class="app-actions">' + actions + '</div>' : '') + '</article>';
  }

  function normalizeUsage(data) {
    var out = {};
    var stats = data && (data.stats || data.data || data.usage || data);
    function add(point) {
      if (!point || typeof point !== "object") return;
      var key = point.period_start || point.time || point.date || point.created_at;
      var value = point.total_traffic || point.traffic || point.used_traffic || point.value || 0;
      if (!key) return;
      out[key] = (out[key] || 0) + (Number(value) || 0);
    }
    if (Array.isArray(stats)) stats.forEach(add);
    else if (stats && typeof stats === "object") {
      Object.keys(stats).forEach(function (key) {
        if (Array.isArray(stats[key])) stats[key].forEach(add);
        else if (typeof stats[key] === "number") out[key] = (out[key] || 0) + stats[key];
      });
    }
    return Object.keys(out).sort().map(function (key) { return { time: key, value: out[key] }; });
  }

  function renderUsage(points, range) {
    points = points || [];
    if (!points.length) {
      $("usage-total").textContent = tr("usageTotal") + ": —";
      $("chart").innerHTML = '<div class="empty">' + esc(tr("noUsage")) + '</div>';
      return;
    }
    var maxBars = range === "7d" ? 7 : 8;
    var bucket = Math.max(1, Math.ceil(points.length / maxBars));
    var bars = [];
    for (var i = 0; i < points.length; i += bucket) {
      bars.push({
        time: points[i].time,
        value: points.slice(i, i + bucket).reduce(function (sum, p) { return sum + Number(p.value || 0); }, 0)
      });
    }
    var max = Math.max.apply(null, bars.map(function (bar) { return bar.value; })) || 1;
    var total = bars.reduce(function (sum, bar) { return sum + bar.value; }, 0);
    $("usage-total").textContent = tr("usageTotal") + ": " + bytes(total);
    $("chart").innerHTML = '<div class="bars" style="--bars:' + bars.length + '">' + bars.map(function (bar, index) {
      var height = Math.max(8, Math.round(bar.value / max * 100));
      return '<div class="bar-wrap"><div class="bar" title="' + esc(bytes(bar.value)) + '"><i style="--h:' + height + '%"></i><b>' + esc(shortBytes(bar.value)) + '</b></div><span>' + esc(tick(bar.time, range, index, bars.length)) + '</span></div>';
    }).join("") + '</div>';
  }

  function tick(time, range, index, count) {
    var d = new Date(time || Date.now() - Math.max(0, count - 1 - index) * (range === "1d" ? 3 * 3600000 : 86400000));
    if (isNaN(d.getTime())) return "";
    try {
      return new Intl.DateTimeFormat(range === "1d" ? "en-US" : (fa() ? "fa-IR" : "en-US"), {
        hour: range === "1d" ? "2-digit" : undefined,
        hour12: false,
        weekday: range !== "1d" ? "short" : undefined
      }).format(d).replace(/^24$/, "00");
    } catch (e) { return ""; }
  }

  function syncRangeButtons() {
    document.querySelectorAll(".range-btn").forEach(function (btn) {
      btn.classList.toggle("active", btn.getAttribute("data-range") === state.range);
    });
  }

  function refreshUsageView() {
    if (!state.ctx) return;
    syncRangeButtons();
    if (state.usageRaw !== null) { renderUsage(normalizeUsage(state.usageRaw), state.range); return; }
    loadUsage(state.range);
  }

  function loadUsage(range) {
    if (!state.ctx) return;
    state.range = range || state.range;
    syncRangeButtons();
    $("chart").innerHTML = '<div class="empty">' + esc(tr("loadingUsage")) + '</div>';
    var id = ++state.usageRequest;
    fetchUsage(state.range).then(function (data) {
      if (id !== state.usageRequest) return;
      state.usageRaw = data;
      renderUsage(normalizeUsage(data), state.range);
    });
  }

  function canonical(value) {
    value = String(value || "other").toLowerCase().replace(/[\s_-]+/g, "");
    if (value === "iphone" || value === "ipad" || value === "ipados") return "ios";
    if (value === "mac" || value === "macosx" || value === "macintosh") return "macos";
    if (value === "win" || value === "win32" || value === "win64") return "windows";
    if (value === "tvos" || value === "appletvos") return "appletv";
    if (value === "googletv" || value === "firetv") return "androidtv";
    if (value === "browser" || value === "pwa") return "web";
    return value || "other";
  }

  function detectPlatform(text) {
    text = String(text || "").toLowerCase();
    if (/ios|iphone|ipad|singbox-ios/.test(text)) return "ios";
    if (/android tv|google tv|fire tv/.test(text)) return "androidtv";
    if (/android|apk|hiddify-android/.test(text)) return "android";
    if (/windows|win64|win/.test(text)) return "windows";
    if (/mac|darwin|osx/.test(text)) return "macos";
    if (/linux|ubuntu|debian|appimage/.test(text)) return "linux";
    if (/web|browser|pwa/.test(text)) return "web";
    return "other";
  }

  function currentOS() {
    var ua = (navigator.userAgent || "").toLowerCase();
    var p = (navigator.platform || "").toLowerCase();
    if (/android tv|google tv|fire tv/.test(ua)) return "androidtv";
    if (/android/.test(ua)) return "android";
    if (/iphone|ipad|ipod/.test(ua) || (p === "macintel" && navigator.maxTouchPoints > 1)) return "ios";
    if (/win/.test(p) || /windows/.test(ua)) return "windows";
    if (/mac/.test(p) || /macintosh/.test(ua)) return "macos";
    if (/linux/.test(p) || /linux/.test(ua)) return "linux";
    return "other";
  }

  function platformLabel(platform) {
    var map = { ios: "iOS", android: "Android", windows: "Windows", macos: "macOS", linux: "Linux", appletv: "Apple TV", androidtv: "Android TV", web: "Web", other: tr("other") };
    return map[platform] || platform;
  }

  function platformIcon(platform) {
    platform = canonical(platform);
    if (platform === "ios" || platform === "macos") return svg("apple");
    if (platform === "appletv" || platform === "androidtv") return svg("tv");
    if (platform === "android") return svg("android");
    if (platform === "windows") return svg("windows");
    if (platform === "linux") return svg("linux");
    return svg("net");
  }

  function resolveUrl(url) {
    url = String(url || "");
    if (/^(https?:|data:image|blob:)/i.test(url)) return url;
    try { return new URL(url, state.ctx ? state.ctx.panel + "/" : location.href).href; } catch (e) { return url; }
  }

  function copyText(text, btn) {
    function done() {
      toast(tr("copied"), "success");
      if (btn) {
        btn.classList.add("copied");
        setTimeout(function () { btn.classList.remove("copied"); }, 900);
      }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(String(text || "")).then(done);
    var ta = document.createElement("textarea");
    ta.value = String(text || "");
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    done();
  }

  function loadQrLib() {
    if (window.QRCode) return Promise.resolve();
    if (state.qrPromise) return state.qrPromise;
    state.qrPromise = new Promise(function (resolve, reject) {
      var script = document.createElement("script");
      script.src = "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";
      script.async = true;
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
    return state.qrPromise;
  }

  function openQr(text, title) {
    $("qr-title").textContent = title || "QR";
    $("qr-canvas").textContent = tr("qrLoading");
    openModal("qr-modal");
    loadQrLib().then(function () {
      $("qr-canvas").innerHTML = "";
      try {
        new QRCode($("qr-canvas"), { text: text, width: 208, height: 208, colorDark: "#111827", colorLight: "#ffffff", correctLevel: QRCode.CorrectLevel.M });
      } catch (e) {
        closeModal("qr-modal");
        toast(tr("qrLong"));
      }
    }).catch(function () {
      closeModal("qr-modal");
      toast(tr("qrError"));
    });
  }

  function wgParam(params, name) {
    var direct = params.get(name);
    if (direct !== null && direct !== "") return direct;
    name = String(name || "").toLowerCase();
    var keys = [];
    params.forEach(function (_v, key) { keys.push(key); });
    for (var i = 0; i < keys.length; i++) {
      if (String(keys[i]).toLowerCase() === name) return params.get(keys[i]);
    }
    return "";
  }

  function wgList(value) {
    return String(value || "").split(",").map(function (part) { return part.trim(); }).filter(Boolean).join(", ");
  }

  function wireguardConfigText(raw) {
    raw = String(raw || "").trim();
    if (/^\[Interface\]/i.test(raw)) return raw.slice(-1) === "\n" ? raw : raw + "\n";
    if (!/^wireguard:\/\//i.test(raw)) return null;
    try {
      var u = new URL(raw);
      var p = u.searchParams;
      var privateKey = decodeSafe(u.username || wgParam(p, "privatekey") || "");
      var publicKey = wgParam(p, "publickey");
      var address = wgParam(p, "address");
      var endpoint = wgParam(p, "endpoint");
      if (!privateKey || !publicKey || !address) return null;
      var host = u.hostname;
      if (host && host.indexOf(":") >= 0 && host.charAt(0) !== "[") host = "[" + host + "]";
      if (!endpoint) endpoint = u.port ? host + ":" + u.port : host;
      var lines = ["[Interface]", "PrivateKey = " + privateKey.replace(/\s/g, "+"), "Address = " + wgList(address)];
      var dns = wgParam(p, "dns");
      if (dns) lines.push("DNS = " + wgList(dns));
      var mtu = wgParam(p, "mtu");
      if (mtu) lines.push("MTU = " + mtu);
      var reserved = wgParam(p, "reserved");
      if (reserved) lines.push("Reserved = " + reserved);
      lines.push("", "[Peer]", "PublicKey = " + publicKey.replace(/\s/g, "+"));
      var psk = wgParam(p, "presharedkey");
      if (psk) lines.push("PresharedKey = " + psk.replace(/\s/g, "+"));
      lines.push("AllowedIPs = " + wgList(wgParam(p, "allowedips") || "0.0.0.0/0, ::/0"));
      lines.push("Endpoint = " + endpoint);
      var keepalive = wgParam(p, "keepalive") || wgParam(p, "persistentkeepalive");
      lines.push("PersistentKeepalive = " + (keepalive || "25"));
      return lines.join("\n") + "\n";
    } catch (e) { return null; }
  }

  function wireguardFileName(raw, title) {
    title = String(title || "").trim();
    if (title && title !== tr("subLink")) return safeFile(title);
    try {
      if (/^wireguard:\/\//i.test(raw)) {
        var remark = decodeSafe(new URL(raw).hash.replace(/^#/, ""));
        if (remark) return safeFile(remark);
      }
    } catch (e) {}
    return safeFile("wireguard");
  }

  function safeFile(title) {
    title = String(title || "wireguard").replace(/[\\/:*?"<>|]+/g, "-").replace(/\s+/g, "-");
    return /\.conf$/i.test(title) ? title : title + ".conf";
  }

  function downloadText(text, name) {
    var blob = new Blob([text], { type: "application/x-wireguard-profile;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

  function decodeSafe(value) {
    try { return decodeURIComponent(String(value || "").replace(/\+/g, "%20")).trim(); }
    catch (e) { return String(value || "").trim(); }
  }

  function b64(value) {
    try {
      value = String(value || "").replace(/-/g, "+").replace(/_/g, "/").replace(/\s/g, "");
      while (value.length % 4) value += "=";
      var bin = atob(value);
      var out = Array.prototype.map.call(bin, function (c) { return "%" + ("00" + c.charCodeAt(0).toString(16)).slice(-2); }).join("");
      return decodeURIComponent(out);
    } catch (e) { return ""; }
  }

  function openModal(id) {
    $(id).classList.add("show");
    $(id).setAttribute("aria-hidden", "false");
  }

  function closeModal(id) {
    $(id).classList.remove("show");
    $(id).setAttribute("aria-hidden", "true");
  }

  function renderAll() {
    renderAccount();
    renderNotice();
    renderSupport();
    renderConfigs();
    renderApps();
  }

  function loadAll(ctx) {
    state.ctx = ctx;
    state.user = null;
    state.headers = {};
    state.links = [];
    state.apps = [];
    state.configItems = [];
    state.usageRaw = null;
    state.usageRequest++;
    localStorage.setItem(LS.panel, ctx.panel);
    localStorage.setItem(LS.token, ctx.subUrl);
    loading(true);
    renderConfigs();
    renderSupport();

    fetchLinks().then(function (links) {
      state.links = links || [];
      renderConfigs();
      renderAccount();
    });

    fetchApps().then(function (apps) {
      state.apps = apps || [];
      renderApps();
      renderAccount();
    });

    fetchInfo().then(function (res) {
      state.user = res.user || {};
      state.headers = res.headers || {};
      renderAccount();
      renderNotice();
      renderSupport();
    }).catch(function (err) {
      var message = (err && err.message) || tr("infoError");
      if (location.protocol === "file:") message += " - " + tr("fileHint");
      toast(message);
    }).finally(function () {
      loading(false);
    });

    setTimeout(function () { loadUsage("1d"); }, 0);
  }

  function bindEvents() {
    $("copy-all").addEventListener("click", function () {
      copyText(state.links.join("\n") || (state.ctx && state.ctx.subUrl) || "", $("copy-all"));
    });
    $("copy-sub-link").addEventListener("click", function () {
      if (state.ctx && state.ctx.subUrl) copyText(state.ctx.subUrl, $("copy-sub-link"));
    });
    $("qr-sub-link").addEventListener("click", function () {
      if (state.ctx && state.ctx.subUrl) openQr(state.ctx.subUrl, tr("subLink"));
    });
    $("config-list").addEventListener("click", function (event) {
      var btn = event.target.closest("[data-action]");
      if (!btn) return;
      var card = btn.closest(".config-card");
      if (!card) return;
      var item = state.configItems[Number(card.getAttribute("data-index"))];
      if (!item) return;
      var action = btn.getAttribute("data-action");
      var title = card.getAttribute("data-title") || item.title || "";
      if (action === "copy") copyText(item.payload, btn);
      else if (action === "qr") openQr(item.payload, title);
      else if (action === "download") {
        var conf = wireguardConfigText(item.payload);
        if (conf) downloadText(conf, wireguardFileName(item.payload, title));
      }
    });
    $("os-grid").addEventListener("click", function (event) {
      var btn = event.target.closest(".os-open");
      if (!btn) return;
      var card = btn.closest(".os-card");
      if (card) openApps(card.getAttribute("data-platform"));
    });
    $("theme-btn").addEventListener("click", function () {
      state.theme = state.theme === "dark" ? "light" : "dark";
      localStorage.setItem(LS.theme, state.theme);
      applyTheme();
    });
    $("lang-btn").addEventListener("click", function () {
      state.lang = state.lang === "fa" ? "en" : "fa";
      localStorage.setItem(LS.lang, state.lang);
      applyLang();
    });
    document.querySelectorAll("[data-view]").forEach(function (btn) {
      btn.addEventListener("click", function () { setView(btn.getAttribute("data-view")); });
    });
    document.querySelectorAll(".range-btn").forEach(function (btn) {
      btn.addEventListener("click", function () { loadUsage(btn.getAttribute("data-range")); });
    });
    document.querySelectorAll("[data-close]").forEach(function (btn) {
      btn.addEventListener("click", function () { closeModal(btn.getAttribute("data-close")); });
    });
    document.querySelectorAll(".modal").forEach(function (modal) {
      modal.addEventListener("click", function (event) { if (event.target === modal) closeModal(modal.id); });
    });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") { closeModal("apps-modal"); closeModal("qr-modal"); }
    });
  }

  function setupPerfMode() {
    var lite = false;
    try {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) lite = true;
      if (window.matchMedia("(pointer: coarse)").matches) {
        var cores = navigator.hardwareConcurrency || 8;
        var mem = navigator.deviceMemory || 8;
        if (cores <= 4 || mem <= 4) lite = true;
      }
      if (window.CSS && CSS.supports && !CSS.supports("(backdrop-filter: blur(1px))") && !CSS.supports("(-webkit-backdrop-filter: blur(1px))")) lite = true;
    } catch (e) {}
    if (lite) document.documentElement.setAttribute("data-perf", "lite");
  }

  function init() {
    setupPerfMode();
    installSvg(document);
    applyTheme();
    applyLang();
    bindEvents();
    tickClock();
    state.clockTimer = setInterval(tickClock, 1000);
    requestAnimationFrame(function () {
      var auto = detectUrl();
      if (auto) return loadAll(auto);
      var configured = makeContext(CONFIG.panelUrl || CONFIG.panel || "", CONFIG.subscriptionUrl || CONFIG.subscription || CONFIG.token || CONFIG.sub || "");
      if (configured) return loadAll(configured);
      var savedPanel = localStorage.getItem(LS.panel);
      var savedToken = localStorage.getItem(LS.token);
      if (savedPanel && savedToken) {
        var ctx = makeContext(savedPanel, savedToken);
        if (ctx) loadAll(ctx);
      }
    });
  }

  init();
})();
  </script>
</body>
</html>
