<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="color-scheme" content="dark light">
  <title>پنل کاربری - <%= data.user.email %></title>
  <style>
    @font-face {
      font-family: Vazirmatn;
      src: url("https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn%5Bwght%5D.woff2") format("woff2-variations");
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    :root {
      color-scheme: dark;
      --ink: #f4f6fd;
      --muted: rgba(244, 246, 253, 0.66);
      --faint: rgba(244, 246, 253, 0.4);
      --line: rgba(255, 255, 255, 0.16);
      --line-soft: rgba(255, 255, 255, 0.09);
      --bg: #06080f;
      --glass: rgba(13, 16, 30, 0.78);
      --glass-2: rgba(10, 13, 24, 0.66);
      --chip-bg: rgba(9, 12, 22, 0.6);
      --nav-bg: rgba(11, 14, 27, 0.92);
      --nav-border: rgba(139, 168, 255, 0.2);
      --accent: #8ba8ff;
      --accent-2: #6f8dff;
      --accent-soft: rgba(139, 168, 255, 0.12);
      --accent-line: rgba(139, 168, 255, 0.28);
      --good: #5fe0a0;
      --good-soft: rgba(95, 224, 160, 0.12);
      --good-line: rgba(95, 224, 160, 0.4);
      --warn: #f4c86c;
      --warn-soft: rgba(244, 200, 108, 0.12);
      --warn-line: rgba(244, 200, 108, 0.38);
      --bad: #ff8f86;
      --bad-soft: rgba(255, 143, 134, 0.12);
      --bad-line: rgba(255, 143, 134, 0.4);
      --cyan: #38d5f5;
      --cyan-soft: rgba(56, 213, 245, 0.12);
      --violet: #c08bff;
      --violet-soft: rgba(192, 139, 255, 0.12);
      --teal: #38e0c4;
      --teal-soft: rgba(56, 224, 196, 0.12);
      --orange: #ffab66;
      --orange-soft: rgba(255, 171, 102, 0.12);
      --rose: #ff85be;
      --rose-soft: rgba(255, 133, 190, 0.12);
      --modal-overlay: rgba(2, 4, 10, 0.64);
      --modal-surface: rgba(12, 15, 28, 0.97);
      --ring-track: rgba(255, 255, 255, 0.07);
      --ring-dots: rgba(139, 168, 255, 0.3);
      --shadow: 0 18px 44px rgba(0, 0, 0, 0.42);
      --r-card: 24px;
      --r-box: 17px;
      --r-control: 14px;
      --page: 1140px;
      --nav-height: 76px;
      --page-bottom: calc(var(--nav-height) + 26px + env(safe-area-inset-bottom, 0px) + 28px);
    }

    html[data-theme="light"] {
      color-scheme: light;
      --ink: #101a2e;
      --muted: rgba(16, 26, 46, 0.66);
      --faint: rgba(16, 26, 46, 0.44);
      --line: rgba(16, 26, 46, 0.13);
      --line-soft: rgba(16, 26, 46, 0.08);
      --bg: #e9f0fa;
      --glass: rgba(255, 255, 255, 0.86);
      --glass-2: rgba(255, 255, 255, 0.68);
      --chip-bg: rgba(255, 255, 255, 0.78);
      --nav-bg: rgba(255, 255, 255, 0.94);
      --nav-border: rgba(74, 108, 216, 0.18);
      --accent: #4a6cd8;
      --accent-2: #3d5cc4;
      --accent-soft: rgba(74, 108, 216, 0.1);
      --accent-line: rgba(74, 108, 216, 0.26);
      --good: #16a26a;
      --good-soft: rgba(22, 162, 106, 0.1);
      --good-line: rgba(22, 162, 106, 0.34);
      --warn: #c07f16;
      --warn-soft: rgba(192, 127, 22, 0.1);
      --warn-line: rgba(192, 127, 22, 0.32);
      --bad: #d64545;
      --bad-soft: rgba(214, 69, 69, 0.09);
      --bad-line: rgba(214, 69, 69, 0.32);
      --cyan: #0d94b5;
      --cyan-soft: rgba(13, 148, 181, 0.1);
      --violet: #8b4fd6;
      --violet-soft: rgba(139, 79, 214, 0.1);
      --teal: #0d9e8a;
      --teal-soft: rgba(13, 158, 138, 0.1);
      --orange: #d97a2b;
      --orange-soft: rgba(217, 122, 43, 0.1);
      --rose: #d1447e;
      --rose-soft: rgba(209, 68, 126, 0.1);
      --modal-overlay: rgba(20, 30, 55, 0.36);
      --modal-surface: rgba(255, 255, 255, 0.98);
      --ring-track: rgba(16, 26, 46, 0.07);
      --ring-dots: rgba(74, 108, 216, 0.32);
      --shadow: 0 16px 40px rgba(60, 90, 160, 0.14);
    }

    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      min-height: 100dvh;
      font-family: Vazirmatn, "Segoe UI", Tahoma, sans-serif;
      color: var(--ink);
      background: var(--bg);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(52rem 34rem at 84% -6%, rgba(101, 132, 255, 0.2), transparent 60%),
        radial-gradient(46rem 30rem at -8% 30%, rgba(56, 213, 245, 0.1), transparent 62%),
        radial-gradient(50rem 36rem at 50% 112%, rgba(140, 96, 255, 0.13), transparent 64%);
      pointer-events: none;
    }
    html[data-theme="light"] body::before {
      background:
        radial-gradient(52rem 34rem at 84% -6%, rgba(74, 108, 216, 0.14), transparent 60%),
        radial-gradient(46rem 30rem at -8% 30%, rgba(13, 148, 181, 0.08), transparent 62%),
        radial-gradient(50rem 36rem at 50% 112%, rgba(139, 79, 214, 0.08), transparent 64%);
    }

    .page {
      max-width: var(--page);
      margin: 0 auto;
      padding: 18px clamp(14px, 3vw, 28px) var(--page-bottom);
    }

    .glass {
      background: var(--glass);
      border: 1px solid var(--line-soft);
      border-radius: var(--r-card);
      box-shadow: var(--shadow);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    html[data-perf="lite"] .glass { backdrop-filter: none; -webkit-backdrop-filter: none; }

    /* ---------- header ---------- */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      margin-bottom: 14px;
    }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-logo {
      width: 46px; height: 46px;
      display: grid; place-items: center;
      border-radius: 15px;
      color: var(--accent);
      background: linear-gradient(140deg, var(--accent-soft), transparent 70%);
      border: 1px solid var(--accent-line);
      overflow: hidden;
      flex: none;
    }
    .brand-logo svg { width: 26px; height: 26px; }
    .brand-logo img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .brand-logo.has-image img { display: block; }
    .brand-logo.has-image svg { display: none; }
    .brand-title { margin: 0; font-size: 16px; font-weight: 800; letter-spacing: 0.2px; }
    .brand-sub { margin: 2px 0 0; font-size: 11.5px; color: var(--muted); }
    .actions { display: flex; align-items: center; gap: 8px; }
    .icon-btn {
      width: 40px; height: 40px;
      display: grid; place-items: center;
      border-radius: 13px;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      color: var(--ink);
      cursor: pointer;
      font: inherit; font-size: 12px; font-weight: 700;
      transition: border-color 0.18s, transform 0.18s, background 0.18s;
      -webkit-tap-highlight-color: transparent;
      text-decoration: none;
    }
    .icon-btn:hover { border-color: var(--accent-line); transform: translateY(-1px); }
    .icon-btn svg { width: 18px; height: 18px; }
    .icon-btn.alert-active { color: var(--bad); border-color: var(--bad-line); animation: pulse 1.6s infinite; }
    @keyframes pulse { 50% { box-shadow: 0 0 0 5px var(--bad-soft); } }
    .hidden { display: none !important; }

    /* ---------- banners ---------- */
    .alert-banner, .notice {
      display: none;
      margin-bottom: 12px;
      padding: 11px 16px;
      border-radius: var(--r-box);
      font-size: 12.5px;
      text-align: center;
      line-height: 1.8;
    }
    .alert-banner { border: 1px solid var(--bad-line); background: var(--bad-soft); color: var(--bad); }
    .notice { border: 1px solid var(--warn-line); background: var(--warn-soft); color: var(--warn); }
    .alert-banner.show, .notice.show { display: block; }
    .notice a { color: inherit; font-weight: 700; }

    /* ---------- views ---------- */
    .view { display: none; animation: rise 0.34s ease; }
    body[data-view="account"] #view-account,
    body[data-view="configs"] #view-configs,
    body[data-view="apps"] #view-apps { display: block; }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

    .panel { padding: 20px; margin-bottom: 16px; }

    /* ---------- profile ---------- */
    .profile-row {
      display: flex; align-items: center; gap: 14px;
      margin-bottom: 16px;
    }
    .avatar {
      width: 58px; height: 58px; flex: none;
      position: relative;
      display: grid; place-items: center;
      border-radius: 50%;
      font-size: 23px; font-weight: 800;
      color: #fff;
      background: linear-gradient(140deg, var(--accent-2), var(--violet));
      box-shadow: 0 8px 22px rgba(111, 141, 255, 0.35);
    }
    .avatar .presence {
      position: absolute;
      bottom: 1px; inset-inline-start: 1px;
      width: 15px; height: 15px;
      border-radius: 50%;
      background: var(--faint);
      border: 3px solid var(--bg);
    }
    .avatar .presence.on { background: var(--good); }
    .profile-main { min-width: 0; flex: 1; }
    .username {
      margin: 0;
      font-size: 20px; font-weight: 800;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      direction: ltr; text-align: start;
      unicode-bidi: plaintext;
    }
    .subline { margin: 3px 0 0; font-size: 12px; color: var(--muted); }
    .chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 11px;
      border-radius: 999px;
      font-size: 11.5px; font-weight: 700;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      color: var(--muted);
      white-space: nowrap;
    }
    .chip .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px var(--good); }
    .chip.status-active { color: var(--good); border-color: var(--good-line); background: var(--good-soft); }
    .chip.status-warn { color: var(--warn); border-color: var(--warn-line); background: var(--warn-soft); }
    .chip.status-warn .dot { background: var(--warn); box-shadow: 0 0 8px var(--warn); }
    .chip.status-bad { color: var(--bad); border-color: var(--bad-line); background: var(--bad-soft); }
    .chip.status-bad .dot { background: var(--bad); box-shadow: 0 0 8px var(--bad); }
    .chip-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }

    .profile-shortcuts { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
    .ghost {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 14px;
      border-radius: var(--r-control);
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      color: var(--ink);
      font: inherit; font-size: 12px; font-weight: 700;
      cursor: pointer;
      transition: border-color 0.18s, transform 0.18s;
      -webkit-tap-highlight-color: transparent;
    }
    .ghost:hover { border-color: var(--accent-line); transform: translateY(-1px); }
    .ghost svg { width: 15px; height: 15px; }
    .ghost.copied { color: var(--good); border-color: var(--good-line); }

    /* ---------- clock + expiry hero ---------- */
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }
    .hero-card {
      position: relative;
      overflow: hidden;
      padding: 18px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
      display: flex; flex-direction: column; gap: 6px;
      min-height: 118px;
    }
    .hero-card::after {
      content: "";
      position: absolute; inset: 0;
      background: radial-gradient(16rem 9rem at 85% -20%, var(--accent-soft), transparent 70%);
      pointer-events: none;
    }
    .hero-k {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 700; color: var(--muted);
    }
    .hero-k .stat-icon { width: 28px; height: 28px; border-radius: 9px; }
    .hero-clock-time {
      font-size: clamp(26px, 6vw, 34px);
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
      direction: ltr; text-align: start;
      line-height: 1.15;
    }
    .hero-clock-date, .hero-sub { font-size: 12px; color: var(--muted); }
    .hero-expire-date { font-size: clamp(19px, 4.4vw, 24px); font-weight: 800; line-height: 1.3; }
    .hero-expire-date.tone-warn { color: var(--warn); }
    .hero-expire-date.tone-bad { color: var(--bad); }

    /* ---------- rings ---------- */
    .rings-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }
    .ring-card {
      padding: 18px 14px 14px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .ring-title { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 800; color: var(--muted); }
    .ring-wrap { position: relative; width: min(170px, 58vw); aspect-ratio: 1; }
    .ring-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .ring-track { fill: none; stroke: var(--ring-track); stroke-width: 10; }
    .ring-dots { fill: none; stroke: var(--ring-dots); stroke-width: 2.5; stroke-dasharray: 2 7; stroke-linecap: round; opacity: 0.85; }
    .ring-fill {
      fill: none;
      stroke: var(--accent);
      stroke-width: 10;
      stroke-linecap: round;
      stroke-dasharray: 527.8;
      stroke-dashoffset: 527.8;
      transition: stroke-dashoffset 0.9s cubic-bezier(0.22, 1, 0.36, 1), stroke 0.3s;
      filter: drop-shadow(0 0 6px var(--accent-soft));
    }
    .ring-card.tone-good .ring-fill { stroke: var(--good); }
    .ring-card.tone-warn .ring-fill { stroke: var(--warn); }
    .ring-card.tone-bad .ring-fill { stroke: var(--bad); }
    .ring-center {
      position: absolute; inset: 0;
      display: grid; place-content: center; text-align: center; gap: 2px;
    }
    .ring-value { font-size: clamp(26px, 6vw, 34px); font-weight: 800; line-height: 1.1; }
    .ring-card.tone-good .ring-value { color: var(--good); }
    .ring-card.tone-warn .ring-value { color: var(--warn); }
    .ring-card.tone-bad .ring-value { color: var(--bad); }
    .ring-unit { font-size: 11.5px; color: var(--muted); }
    .ring-foot {
      width: 100%;
      padding-top: 11px;
      border-top: 1px dashed var(--line-soft);
      display: flex; justify-content: center;
      font-size: 12px; color: var(--muted);
      text-align: center;
    }
    .ring-foot b { color: var(--ink); margin: 0 4px; }

    /* ---------- stat cards ---------- */
    .metrics {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .metric, .detail {
      padding: 13px 14px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
      display: flex; flex-direction: column; gap: 8px;
      min-width: 0;
    }
    .stat-top { display: flex; align-items: center; gap: 8px; }
    .stat-icon {
      width: 30px; height: 30px; flex: none;
      display: grid; place-items: center;
      border-radius: 10px;
      color: var(--accent);
      background: var(--accent-soft);
    }
    .stat-icon svg { width: 15px; height: 15px; }
    .stat-icon.tone-good { color: var(--good); background: var(--good-soft); }
    .stat-icon.tone-warn { color: var(--warn); background: var(--warn-soft); }
    .stat-icon.tone-bad { color: var(--bad); background: var(--bad-soft); }
    .stat-icon.tone-cyan { color: var(--cyan); background: var(--cyan-soft); }
    .stat-icon.tone-violet { color: var(--violet); background: var(--violet-soft); }
    .stat-icon.tone-teal { color: var(--teal); background: var(--teal-soft); }
    .stat-icon.tone-orange { color: var(--orange); background: var(--orange-soft); }
    .stat-icon.tone-rose { color: var(--rose); background: var(--rose-soft); }
    .stat-icon.tone-muted { color: var(--faint); background: var(--chip-bg); }
    .metric .k, .detail .k { font-size: 11.5px; color: var(--muted); font-weight: 700; }
    .metric .v, .detail .v {
      font-size: 15px; font-weight: 800;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .detail .v {
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: break-word;
      unicode-bidi: plaintext;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 10px;
    }

    /* ---------- section heads / usage ---------- */
    .section-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px; margin-bottom: 14px;
    }
    .title { margin: 0; font-size: 15.5px; font-weight: 800; }
    .note { margin: 3px 0 0; font-size: 11.5px; color: var(--muted); }
    .range { display: flex; gap: 5px; padding: 4px; border-radius: var(--r-control); border: 1px solid var(--line-soft); background: var(--chip-bg); }
    .range-btn {
      padding: 7px 15px;
      border: none; border-radius: 10px;
      background: transparent;
      color: var(--muted);
      font: inherit; font-size: 12px; font-weight: 700;
      cursor: pointer;
      transition: background 0.18s, color 0.18s;
      -webkit-tap-highlight-color: transparent;
    }
    .range-btn.active { background: var(--accent); color: #fff; }
    html[data-theme="dark"] .range-btn.active { color: #0a0f1e; }

    .chart { min-height: 170px; display: grid; }
    .bars {
      display: grid;
      grid-template-columns: repeat(var(--bars, 8), 1fr);
      gap: 8px;
      align-items: end;
      min-height: 170px;
      direction: ltr;
    }
    .bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 7px; min-width: 0; }
    .bar {
      position: relative;
      width: 100%; max-width: 44px;
      height: 128px;
      border-radius: 12px;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      overflow: hidden;
    }
    .bar i {
      position: absolute; inset-inline: 0; bottom: 0;
      height: var(--h, 8%);
      border-radius: 11px 11px 0 0;
      background: linear-gradient(180deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 12px var(--accent-soft);
      animation: grow 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes grow { from { height: 0; } }
    .bar b {
      position: absolute; inset-inline: 0; top: 6px;
      font-size: 9.5px; font-weight: 700;
      color: var(--muted);
      text-align: center;
      writing-mode: vertical-lr;
      margin: 0 auto;
    }
    .bar-wrap > span { font-size: 10px; color: var(--faint); }
    .empty { display: grid; place-items: center; min-height: 130px; color: var(--faint); font-size: 12.5px; }

    /* ---------- config / server list ---------- */
    .list { display: flex; flex-direction: column; gap: 9px; }
    .config-card {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 14px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
      transition: border-color 0.18s, transform 0.18s;
    }
    .config-card:hover { border-color: var(--accent-line); transform: translateY(-1px); }
    .config-card .flag {
      width: 40px; height: 40px; flex: none;
      display: grid; place-items: center;
      border-radius: 12px;
      font-size: 21px;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      color: var(--accent);
    }
    .config-card .flag svg { width: 19px; height: 19px; }
    .config-card .flag .flag-svg {
      width: 22px; height: 22px;
      border-radius: 50%;
      display: block;
    }
    .item-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6px; }
    .item-title {
      font-size: 13.5px; font-weight: 800;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      direction: ltr; text-align: start;
      unicode-bidi: plaintext;
    }
    .tag-row { display: flex; flex-wrap: wrap; gap: 5px; }
    .tag {
      padding: 2.5px 9px;
      border-radius: 7px;
      font-size: 9.8px; font-weight: 800;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      direction: ltr;
    }
    .tag.proto { color: var(--violet); background: var(--violet-soft); }
    .tag.sec { color: var(--good); background: var(--good-soft); }
    .tag.net { color: var(--cyan); background: var(--cyan-soft); }
    .row-actions { display: flex; gap: 6px; flex: none; }
    .row-actions .icon-btn { width: 36px; height: 36px; border-radius: 11px; }
    .row-actions .icon-btn svg { width: 16px; height: 16px; }
    .icon-btn.copied { color: var(--good); border-color: var(--good-line); }

    /* ---------- apps ---------- */
    .os-grid { display: flex; flex-direction: column; gap: 9px; }
    .os-card {
      display: flex; align-items: center; gap: 13px;
      padding: 13px 15px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
      transition: border-color 0.18s, transform 0.18s;
    }
    .os-card:hover { border-color: var(--accent-line); transform: translateY(-1px); }
    .os-card.current { border-color: var(--good-line); background: var(--good-soft); }
    .os-icon {
      width: 42px; height: 42px; flex: none;
      display: grid; place-items: center;
      border-radius: 13px;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      color: var(--ink);
    }
    .os-icon svg { width: 21px; height: 21px; }
    .os-info { flex: 1; min-width: 0; display: flex; align-items: center; gap: 9px; }
    .os-name { font-size: 14px; font-weight: 800; }
    .badge {
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 10px; font-weight: 800;
    }
    .badge.current-tag { color: var(--good); background: var(--good-soft); border: 1px solid var(--good-line); }
    .badge.rec { color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line); }
    .small-btn {
      padding: 8px 17px;
      border-radius: var(--r-control);
      border: 1px solid var(--accent-line);
      background: var(--accent-soft);
      color: var(--accent);
      font: inherit; font-size: 12px; font-weight: 800;
      cursor: pointer;
      transition: transform 0.18s;
      -webkit-tap-highlight-color: transparent;
    }
    .small-btn:hover { transform: translateY(-1px); }

    /* ---------- bottom nav ---------- */
    .mobile-nav {
      position: fixed;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      inset-inline: 0;
      margin: 0 auto;
      width: min(400px, calc(100% - 28px));
      height: var(--nav-height);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 5px;
      padding: 8px;
      border-radius: 26px;
      border: 1px solid var(--nav-border);
      background: var(--nav-bg);
      box-shadow: var(--shadow);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      z-index: 40;
    }
    .nav-tab {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
      border: none; border-radius: 19px;
      background: transparent;
      color: var(--muted);
      font: inherit; font-size: 10.5px; font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      -webkit-tap-highlight-color: transparent;
    }
    .nav-tab svg { width: 20px; height: 20px; }
    body[data-view="account"] .nav-tab[data-view="account"],
    body[data-view="configs"] .nav-tab[data-view="configs"],
    body[data-view="apps"] .nav-tab[data-view="apps"] {
      color: var(--accent);
      background: var(--accent-soft);
    }

    /* ---------- modals ---------- */
    .modal {
      position: fixed; inset: 0;
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding: 16px;
      background: var(--modal-overlay);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 60;
    }
    .modal.show { display: flex; animation: fade 0.22s ease; }
    @keyframes fade { from { opacity: 0; } }
    .sheet, .qr-box {
      width: min(560px, 100%);
      max-height: min(78dvh, 640px);
      background: var(--modal-surface);
      border-radius: 24px;
      display: flex; flex-direction: column;
      overflow: hidden;
      animation: sheet-up 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes sheet-up { from { transform: translateY(28px); opacity: 0; } }
    .sheet-head, .qr-head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 17px 19px 13px;
      border-bottom: 1px solid var(--line-soft);
    }
    .sheet-title, .qr-title { margin: 0; font-size: 15px; font-weight: 800; }
    .sheet-sub { margin: 3px 0 0; font-size: 11.5px; color: var(--muted); }
    .sheet-body { overflow-y: auto; padding: 15px 19px 19px; }
    .app-list { display: flex; flex-direction: column; gap: 10px; }
    .app-card {
      padding: 14px;
      border-radius: var(--r-box);
      border: 1px solid var(--line-soft);
      background: var(--glass-2);
    }
    .app-head { display: flex; gap: 12px; align-items: flex-start; }
    .app-icon {
      width: 42px; height: 42px; flex: none;
      display: grid; place-items: center;
      border-radius: 13px;
      border: 1px solid var(--line-soft);
      background: var(--chip-bg);
      overflow: hidden;
    }
    .app-icon svg { width: 20px; height: 20px; }
    .app-icon img { width: 100%; height: 100%; object-fit: cover; }
    .app-info { min-width: 0; flex: 1; }
    .app-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13.5px; font-weight: 800; }
    .app-desc { margin: 5px 0 0; font-size: 11.5px; color: var(--muted); line-height: 1.7; }
    .app-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
    .app-actions a {
      padding: 8px 15px;
      border-radius: var(--r-control);
      font-size: 12px; font-weight: 700;
      text-decoration: none;
      border: 1px solid var(--line-soft);
      color: var(--ink);
      background: var(--chip-bg);
      transition: border-color 0.18s;
    }
    .app-actions a:hover { border-color: var(--accent-line); }
    .app-actions a.action-import { color: var(--good); border-color: var(--good-line); background: var(--good-soft); }
    .qr-box { align-self: center; width: min(320px, 100%); }
    .qr-canvas {
      display: grid; place-items: center;
      padding: 22px;
      min-height: 240px;
      color: var(--muted); font-size: 12.5px;
    }
    .qr-canvas img, .qr-canvas canvas { border-radius: 14px; background: #fff; padding: 10px; }

    /* ---------- toast / loading ---------- */
    .toast {
      position: fixed;
      bottom: calc(var(--nav-height) + 34px + env(safe-area-inset-bottom, 0px));
      inset-inline: 0;
      margin: 0 auto;
      width: fit-content;
      max-width: calc(100% - 40px);
      padding: 10px 20px;
      border-radius: 999px;
      border: 1px solid var(--line-soft);
      background: var(--modal-surface);
      color: var(--ink);
      font-size: 12.5px; font-weight: 700;
      opacity: 0;
      transform: translateY(8px);
      pointer-events: none;
      transition: opacity 0.22s, transform 0.22s;
      z-index: 70;
      box-shadow: var(--shadow);
    }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { color: var(--good); border-color: var(--good-line); }
    .loading {
      position: fixed; inset: 0;
      display: none;
      place-items: center;
      background: var(--modal-overlay);
      backdrop-filter: blur(4px);
      z-index: 80;
    }
    .loading.show { display: grid; }
    .loader {
      padding: 15px 25px;
      border-radius: var(--r-box);
      background: var(--modal-surface);
      border: 1px solid var(--line-soft);
      font-size: 13px; font-weight: 700;
      display: flex; align-items: center; gap: 11px;
    }
    .loader::before {
      content: "";
      width: 17px; height: 17px;
      border-radius: 50%;
      border: 2.5px solid var(--accent-soft);
      border-top-color: var(--accent);
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ---------- desktop ---------- */
    @media (min-width: 860px) {
      :root { --page: 1280px; }
      body { display: flex; flex-direction: column; }
      .mobile-nav {
        order: -1;
        position: static;
        width: fit-content;
        height: auto;
        margin: 22px auto 0;
        grid-template-columns: repeat(3, auto);
        gap: 4px;
        padding: 6px;
        border-radius: 18px;
      }
      .nav-tab {
        flex-direction: row;
        gap: 9px;
        padding: 11px 26px;
        font-size: 13px;
        border-radius: 13px;
      }
      .nav-tab svg { width: 18px; height: 18px; }
      .page { padding-top: 16px; padding-bottom: 44px; }
      .toast { bottom: 40px; }

      .metrics { grid-template-columns: repeat(auto-fit, minmax(158px, 1fr)); }
      .detail-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
      .hero-grid { grid-template-columns: repeat(2, 1fr); }
      .account-grid {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: 16px;
        align-items: stretch;
      }
      .account-grid > * { margin-bottom: 0; }
      .account-grid > div:first-child { display: flex; }
      .account-grid > div:first-child > .panel {
        flex: 1;
        display: flex; flex-direction: column;
      }
      .account-grid > div:first-child .rings-grid { flex: 1; }
      .account-grid > div:first-child .ring-wrap { margin-block: auto; }
      .list, .os-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }
      .chart { min-height: 230px; }
      .bars { min-height: 230px; }
      .bar-wrap .bar { height: 190px; max-width: 56px; }
      .bar b { writing-mode: horizontal-tb; font-size: 10.5px; }
      .bar-wrap > span { font-size: 11px; }
      .modal { align-items: center; padding: 28px; }
    }
    @media (min-width: 1180px) {
      .list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .os-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 420px) {
      .hero-grid, .rings-grid { grid-template-columns: 1fr; }
      .ring-wrap { width: min(180px, 62vw); }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>

  <!-- ============ X-UI / PGClock FUSION INTERCEPTOR ============ -->
  <script>
    // 1. Preload Data injected from Node.js server (3x-ui API)
    window.PRELOADED_DATA = {
      user: <%- JSON.stringify(data.user) %>,
      links: <%- JSON.stringify(data.links) %>,
      apps: <%- JSON.stringify(data.apps || []) %>,
      headers: { 
        announce: "", 
        announceUrl: "", 
        supportUrl: "<%= data.user.support_url %>" 
      },
      ctx: { 
        subUrl: "<%= data.suburl %>", 
        panel: "<%= data.suburl %>" 
      }
    };

    // 2. Brand & Config settings for PGClock script
    window.PASARGUARD_CONFIG = {
      subscriptionUrl: "<%= data.suburl %>",
      panelUrl: "<%= data.suburl %>",
      supportUrl: "<%= data.user.support_url %>"
    };

    window.PANEL_BRAND = {
      name: "<%= data.brandName %>",
      subtitle: { fa: "<%= data.brandName %>", en: "<%= data.brandName %>" },
      logoUrl: "<%= data.brandLogo %>"
    };

    // 3. Intercept global fetch to serve preloaded data instead of calling Pasarguard API
    const originalFetch = window.fetch;
    window.fetch = function(url, options) {
      if (typeof url === 'string') {
        if (url.includes('/info') || url.includes('/info.json') || url.endsWith('/user')) {
          return Promise.resolve({ 
            ok: true, 
            json: () => Promise.resolve({ user: window.PRELOADED_DATA.user, headers: window.PRELOADED_DATA.headers }) 
          });
        }
        if (url.includes('/links') || url.includes('/links.json')) {
          return Promise.resolve({ 
            ok: true, 
            json: () => Promise.resolve(window.PRELOADED_DATA.links) 
          });
        }
        if (url.includes('/apps') || url.includes('/apps.json')) {
          return Promise.resolve({ 
            ok: true, 
            json: () => Promise.resolve(window.PRELOADED_DATA.apps) 
          });
        }
        if (url.includes('/usage') || url.includes('/usage.json')) {
          return Promise.resolve({ 
            ok: true, 
            json: () => Promise.resolve([]) 
          });
        }
        // Handle sub link fetching for base64 configs
        if (url === window.PRELOADED_DATA.ctx.subUrl || url.endsWith('/raw')) {
           return Promise.resolve({
             ok: true,
             text: () => Promise.resolve(window.PRELOADED_DATA.links.join('\n')),
             json: () => Promise.resolve({ links: window.PRELOADED_DATA.links })
           });
        }
      }
      return originalFetch.apply(this, arguments);
    };
  </script>
</head>
