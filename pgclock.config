# ==========================================
# Configuration File for PGClock X-UI Panel
# ==========================================

# http/https Panel
PROTOCOL=https

# Panel Domain or IP Address
HOST=domain.com

# Panel Port (3x-ui default is usually 2053 or 2096)
PORT=2053

# Panel Path (اگر مسیر پنل را عوض کرده‌اید اینجا بنویسید)
PATH=

# Login Credentials
USERNAME=admin
PASSWORD=admin

# 2FA AUTH
TWO_FACTOR=false
TOTP_SECRET=

# Subscription Link (Base URL for sub links)
SUBSCRIPTION=https://domain.com:2096/sub/

# SSL Certificates for the Template Server
PUBLIC_KEY_PATH=/root/cert/domain.com/fullchain.pem
PRIVATE_KEY_PATH=/root/cert/domain.com/privkey.pem

# Backup Link
Backup_link=

# Template Server Ports
SUB_HTTP_PORT=2082
SUB_HTTPS_PORT=2083

# Template name 
TEMPLATE_NAME=default

# Branding
BRAND_NAME=PGClock X-UI
BRAND_LOGO=

# Support Link
TELEGRAM_URL=https://t.me/your_channel
WHATSAPP_URL=
